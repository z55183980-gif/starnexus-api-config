{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarNexus API",
  "version": "0.1.0",
  "identifier": "com.starnexus.dbkey",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "星域互联 API",
        "width": 560,
        "height": 720,
        "minWidth": 480,
        "minHeight": 560,
        "resizable": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "mainBinaryName": "starnexus-api"
}